# Copy this to `.env` in the repo root (never commit it) and fill it in. Compose reads it.
#
# QUOTE nothing and add no spaces around '='. Two values below need care with the '$' character;
# each says how.

# The database password inside the deployment. Any strong random string; it never leaves the host.
OPSAGENT_DB_PASSWORD=change-me-to-something-random

# The public hostname. DNS for this must point at the host before you deploy, or Caddy cannot get a
# certificate. A free DuckDNS name works: e.g. opsagent-yourname.duckdns.org
OPSAGENT_DOMAIN=opsagent-yourname.duckdns.org

# The screen's single password, as "username hashed-password". Generate the hash with:
#   docker run --rm caddy caddy hash-password --plaintext 'your-password'
# The hash is bcrypt and contains '$' signs. Compose treats a single '$' as a variable, so DOUBLE
# every '$' here: a hash printed as $2a$14$abc... goes in as $$2a$$14$$abc...
OPSAGENT_BASICAUTH=admin $$2a$$14$$replace-with-your-doubled-hash

# The name recorded against approvals and, later, who decided. Without it the screen shows what is
# waiting but records no decisions.
OPSAGENT_OPERATOR=yourname

# How long the worker sleeps between passes, in seconds. Optional.
OPSAGENT_LOOP_SECONDS=20

# --- Channels and replies (all optional) --------------------------------------------------------
# Leave any of these blank to run the demo without that channel. See the README's "Real channels".
# Values with spaces (a Gmail app password) must be handled as the README describes.
OPSAGENT_IMAP_HOST=
OPSAGENT_IMAP_USER=
OPSAGENT_IMAP_PASSWORD=
OPSAGENT_SMTP_HOST=
OPSAGENT_SMTP_PORT=587
OPSAGENT_TELEGRAM_TOKEN=
